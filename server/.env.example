# Backend Supabase Configuration
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Email Configuration
BREVO_API_KEY=
BREVO_NEWSLETTER_LIST_ID=3
# Shared secret sent by Brevo in the x-weekplore-webhook-secret header.
BREVO_WEBHOOK_SECRET=
# Public HTTPS backend origin; used by configure-newsletter-webhook.mjs after deployment.
BREVO_WEBHOOK_BASE_URL=
RESEND_API_KEY=
NEWSLETTER_PROVIDER=resend
RESEND_NEWSLETTER_API_KEY=
RESEND_NEWSLETTER_SEGMENT_ID=4f65d44a-6877-4824-849a-c348f517f224
RESEND_NEWSLETTER_FROM=Weekplore <hello@weekplore.gr>
RESEND_NEWSLETTER_WEBHOOK_SECRET=
EMAIL_FROM=
# Optional comma-separated override for private event inquiry notifications.
# Falls back to ADMIN_EMAILS when omitted.
PRIVATE_EVENT_ADMIN_EMAIL=

# Booking Cancellation
CANCEL_SECRET=
SERVER_URL=http://localhost:3001
# Public website origin for event alert booking links (use http://localhost:3000 locally).
SITE_URL=https://weekplore.gr
# Optional stable signing secret for event alert unsubscribe links; defaults to CANCEL_SECRET.
NOTIFY_ME_SECRET=

# Comma-separated backend admin allowlist
ADMIN_EMAILS=

# Comma-separated frontend origins allowed to call the backend
CORS_ALLOWED_ORIGINS=http://localhost:3000
